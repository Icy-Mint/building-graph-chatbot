NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
OPENAI_API_KEY=

# Which LLM powers Cypher generation: openai (default) | gemini | groq | anthropic
LLM_PROVIDER=openai
# Optional: override the default model for the selected provider
LLM_MODEL=

# Only needed if LLM_PROVIDER=gemini (free tier key from Google AI Studio)
GOOGLE_API_KEY=
# Only needed if LLM_PROVIDER=groq (free tier key from console.groq.com)
GROQ_API_KEY=
# Only needed if LLM_PROVIDER=anthropic (paid, no free tier -- console.anthropic.com)
ANTHROPIC_API_KEY=
