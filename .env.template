# Cloud (Neo4j Aura) by default. To self-host locally instead -- e.g. to
# reuse dorm-agent/'s local Neo4j (same schema as of the shared-database
# migration) -- point these at it instead:
#   NEO4J_URI=bolt://localhost:7687
#   NEO4J_USERNAME=neo4j
#   NEO4J_PASSWORD=<dorm-agent/.env's NEO4J_PASSWORD>
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
OPENAI_API_KEY=

# Which LLM powers Cypher generation: openai (default) | gemini | groq | anthropic
LLM_PROVIDER=openai
# Optional: override the default model for the selected provider
LLM_MODEL=

# Only needed if LLM_PROVIDER=gemini (free tier key from Google AI Studio)
GOOGLE_API_KEY=
# Only needed if LLM_PROVIDER=groq (free tier key from console.groq.com)
GROQ_API_KEY=
# Only needed if LLM_PROVIDER=anthropic (paid, no free tier -- console.anthropic.com)
ANTHROPIC_API_KEY=

# chatbot.py's sensor data source: csv (default, sensor_outputs/*.csv) |
# timescaledb (dorm-agent's local instance -- requires NEO4J_URI above to
# also point at dorm-agent's local Neo4j, same schema, not Aura).
SENSOR_BACKEND=csv
# Only needed if SENSOR_BACKEND=timescaledb -- same values as
# dorm-agent/.env's POSTGRES_HOST/PORT/DB/READONLY_USER/READONLY_PASSWORD.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_READONLY_USER=
POSTGRES_READONLY_PASSWORD=
